rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserDocument(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function householdDoc(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId));
    }

    function memberDoc(householdId, uid) {
      return get(/databases/$(database)/documents/households/$(householdId)/members/$(uid));
    }

    function householdDocExists(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId));
    }

    function memberDocExists(householdId, uid) {
      return exists(/databases/$(database)/documents/households/$(householdId)/members/$(uid));
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() &&
        memberDocExists(householdId, request.auth.uid) &&
        memberDoc(householdId, request.auth.uid).data.active == true;
    }

    function isHouseholdOwner(householdId) {
      return isSignedIn() &&
        householdDocExists(householdId) &&
        householdDoc(householdId).data.ownerUserId == request.auth.uid;
    }

    function isSelfMemberWrite(householdId, memberId) {
      return isSignedIn() &&
        memberId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.householdId == householdId;
    }

    // A self-join (member create, not update) must reference a real, still-valid invite for
    // this household - otherwise isSelfMemberWrite alone would let any signed-in user join any
    // household they merely know the ID of. The client stamps joinedViaInviteId on the member
    // doc at join time (see MemberEntity.joinedViaInviteId / OfflineFirstHouseholdRepository).
    //
    // A targeted (per-member) invite's targetMemberId is the logical member id (member.id -
    // e.g. a placeholder row's id, see MembersSettingsScreen's GenerateMemberInvite / member.id),
    // NOT the uid the member document is keyed by (memberDocumentId = member.userId ?: member.id
    // in FirebaseHouseholdDataSource). So this must compare against the joining member's own
    // logical id field on the write (request.resource.data.id), never against the {memberId}
    // path segment - those only coincide for a brand-new member with no placeholder to claim.
    function isUnconsumedInviteForMember(invite, memberLogicalId) {
      return invite.get('consumedAt', null) == null &&
        (invite.get('targetMemberId', null) == null || invite.get('targetMemberId', null) == memberLogicalId);
    }

    function isValidJoinInvite(householdId, inviteId, memberLogicalId) {
      return inviteId is string && inviteId.size() > 0 &&
        exists(/databases/$(database)/documents/households/$(householdId)/invites/$(inviteId)) &&
        isUnconsumedInviteForMember(
          get(/databases/$(database)/documents/households/$(householdId)/invites/$(inviteId)).data,
          memberLogicalId,
        );
    }

    function isSelfJoinWithValidInvite(householdId, memberId) {
      return isSelfMemberWrite(householdId, memberId) &&
        isValidJoinInvite(
          householdId,
          request.resource.data.get('joinedViaInviteId', ''),
          request.resource.data.get('id', ''),
        );
    }

    function isOwnMembershipRecord() {
      return isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // The household-owner branch is for upsertMembershipData's batched sync, which re-confirms
    // users/{uid} for members who already have a member doc in that household (a brand new
    // membership only ever gets its userId - and so a users/ write for it - via the joining
    // user's own isSelfJoinWithValidInvite-gated write, never via the owner). Requiring that
    // member doc to already exist here closes the gap where an attacker could otherwise own a
    // throwaway household and use it to overwrite an arbitrary victim's users/{uid} document
    // (e.g. hijacking their fcmToken).
    function canManageUserDocument(userId) {
      return isUserDocument(userId) ||
        (
          isSignedIn() &&
          request.resource.data.userId == userId &&
          request.resource.data.householdId != null &&
          isHouseholdOwner(request.resource.data.householdId) &&
          memberDocExists(request.resource.data.householdId, userId) &&
          memberDoc(request.resource.data.householdId, userId).data.userId == userId
        );
    }

    match /users/{userId} {
      allow read, delete: if isUserDocument(userId);
      allow create, update: if canManageUserDocument(userId);
    }

    // Required for collectionGroup("members") queries in resolveHouseholdId.
    // Firestore v2 does not extend nested match rules to collection group queries —
    // an explicit /{path=**}/members/{memberId} rule is mandatory.
    match /{path=**}/members/{memberId} {
      allow read: if isOwnMembershipRecord();
    }

    // Required for collectionGroup("invites") queries in fetchInviteByCode.
    // Any authenticated user can read invites — needed so a joining user (not yet
    // a member) can look up an invite by code. The 8-char random code is the access
    // token; resource.data checks are omitted because Firestore rejects collection
    // group queries whose rules reference document data without a matching query filter.
    match /{path=**}/invites/{inviteId} {
      allow read: if isSignedIn();
    }

    match /households/{householdId} {
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow read: if isHouseholdMember(householdId);
      allow update, delete: if isHouseholdOwner(householdId);

      match /members/{memberId} {
        allow read: if isHouseholdMember(householdId) || isOwnMembershipRecord();
        allow create: if isHouseholdOwner(householdId) ||
          isSelfJoinWithValidInvite(householdId, memberId);
        // isSelfMemberWrite alone only pins userId/householdId - without the diff check below, a
        // member could self-update their own role to OWNER (undeletable, full write access) or
        // rewrite their logical id (colliding with another member's). displayName/email are the
        // only fields a member's own sync push legitimately changes after the initial join.
        allow update: if isHouseholdOwner(householdId) ||
          (isSelfMemberWrite(householdId, memberId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'email']));
        allow delete: if isHouseholdOwner(householdId);
      }

      match /chores/{choreId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if isHouseholdOwner(householdId);
      }

      match /completions/{completionId} {
        allow read: if isHouseholdMember(householdId);
        // Owner can create any completion (needed for full-snapshot sync where
        // the authenticated user may not be the original completion author).
        // Members can only create completions they authored.
        allow create: if isHouseholdOwner(householdId) ||
          (isHouseholdMember(householdId) && request.resource.data.createdByUserId == request.auth.uid);
        // Owner can update/delete any completion.
        // Members can update/delete completions they authored.
        allow update, delete: if isHouseholdOwner(householdId) ||
          (isHouseholdMember(householdId) && resource.data.createdByUserId == request.auth.uid);
      }

      match /invites/{inviteId} {
        allow read: if isHouseholdMember(householdId);
        allow create, delete: if isHouseholdOwner(householdId);
        allow update: if isHouseholdOwner(householdId) ||
          (isHouseholdMember(householdId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['consumedAt', 'consumedByMemberId']));
      }
    }
  }
}
