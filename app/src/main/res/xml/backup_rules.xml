<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy Auto Backup rules, used on API 30 and below (API 31+ uses data_extraction_rules.xml
   instead - see AndroidManifest.xml's dataExtractionRules/fullBackupContent attributes).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="chore-tracker.db" />
    <exclude domain="database" path="chore-tracker.db-shm" />
    <exclude domain="database" path="chore-tracker.db-wal" />
</full-backup-content>
